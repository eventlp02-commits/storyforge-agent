{
  "name": "@storyforge/agent-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm skill:compile && tsc --noEmit",
    "typecheck": "tsc --noEmit",
